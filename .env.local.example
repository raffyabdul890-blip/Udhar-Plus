# Copy this file to .env.local and fill in your project's values.
# NEXT_PUBLIC_* variables are exposed to the browser — safe only because
# Row Level Security is enforced on every table (see SECURITY.md).

# Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service_role key: Project Settings -> API -> service_role secret.
# SERVER-ONLY — never prefix this with NEXT_PUBLIC_. Used exclusively by
# lib/supabase/admin.ts inside Route Handlers to bridge Firebase-verified
# phone logins into a real Supabase session. Never ship this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Firebase: Project Settings -> General -> Your apps -> Web app config.
# Used for phone number verification (RecaptchaVerifier + signInWithPhoneNumber)
# in app/login/page.tsx. Requires the Phone sign-in provider enabled in
# Firebase Console -> Authentication -> Sign-in method.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
